{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LootDef",
  "type": "object",
  "properties": {
    "Id": {
      "type": "string"
    },
    "NumItems": {
      "type": "integer"
    },
    "GoldQuantity": {
      "type": "integer"
    },
    "AllowDropOnlyItems": {
      "type": "boolean"
    },
    "PercentUncommon": {
      "type": "number"
    },
    "PercentRare": {
      "type": "number"
    },
    "PercentEpic": {
      "type": "number"
    },
    "PercentMythic": {
      "type": "number"
    },
    "ShadyScaleX": {
      "type": "number"
    },
    "ShadyScaleY": {
      "type": "number"
    },
    "ShadyOffsetX": {
      "type": "number"
    },
    "ShadyOffsetY": {
      "type": "number"
    },
    "ShadyModelSource": {
      "type": "string"
    },
    "Items": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/LootItemDef"
      }
    }
  },
  "definitions": {
    "LootItemDef": {
      "type": "object",
      "properties": {
        "CardId": {
          "type": "string"
        },
        "Percent": {
          "type": "number"
        },
        "LootType": {
          "type": "string",
          "enum": [
            "None",
            "Melee_Attack",
            "Ranged_Attack",
            "Magic_Attack",
            "Defense",
            "Fire_Spell",
            "Cold_Spell",
            "Lightning_Spell",
            "Mind_Spell",
            "Shadow_Spell",
            "Holy_Spell",
            "Curse_Spell",
            "Healing_Spell",
            "Book",
            "Small_Weapon",
            "Song",
            "Skill",
            "Power",
            "Injury",
            "Attack",
            "Spell",
            "Boon",
            "Weapon",
            "Armor",
            "Jewelry",
            "Accesory",
            "Pet",
            "Corruption",
            "Enchantment",
            "Food",
            "Flask",
            "Petrare",
            "EchoEconomy",
            "EchoOverpowered",
            "Echo_Spell"
          ]
        },
        "LootRarity": {
          "type": "string",
          "enum": [
            "Common",
            "Uncommon",
            "Rare",
            "Epic",
            "Mythic"
          ]
        },
        "LootMisc": {
          "type": "string"
        }
      }
    }
  }
}